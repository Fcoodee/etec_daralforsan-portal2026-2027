function applyRenames() {
  var ss = sheet_(), sh = verSheet_(ss), v = sh.getDataRange().getValues(), done = 0, failed = 0, plan = [];
  for (var r = 1; r < v.length; r++) {
    if (v[r][10] !== true || !v[r][9] || v[r][9] === v[r][6]) continue;
    if (DRY_RUN) { plan.push(v[r][6] + "  ←  " + v[r][9]); continue; }
    try {
      var f = DriveApp.getFileById(v[r][0]), old = f.getName(), d = f.getDescription();
      f.setDescription("الاسم الأصلي: " + old + (d ? "\n" + d : ""));
      f.setName(v[r][9]);
      sh.getRange(r + 1, 7).setValue(v[r][9]); sh.getRange(r + 1, 11).setValue(false); done++;
    } catch (e) { failed++; }
  }
  if (DRY_RUN) { Logger.log("DRY_RUN: كانت ستُعاد تسمية " + plan.length + " ملفاً:\n" + plan.join("\n")); return; }
  Logger.log("أُعيدت تسمية " + done + " ملفاً، وتعذّر " + failed + ".");
  refreshStatus();
}

/* ========== 3) مشغّل زمني اختياري ========== */
function installTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === "refreshStatus") ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger("refreshStatus").timeBased().everyHours(1).create();
}

/* ========== 4) واجهة الويب ========== */
function doGet(e) {
  var p = (e && e.parameter) || {}, json = null;
  if (p.refresh !== "1") json = CacheService.getScriptCache().get(CACHE_KEY);
  if (!json) {
    try { json = refreshStatus(); }
    catch (err) { json = JSON.stringify({ generatedAt: new Date().toISOString(), errors: [{ key: "refresh", error: err.message }], partial: true }); }
  }
  if (p.callback && /^[A-Za-z_$][\w$]*$/.test(p.callback)) {
    return ContentService.createTextOutput(p.callback + "(" + json + ");").setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}
